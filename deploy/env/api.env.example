# Install as /etc/spyboxd/api.env with mode 0640 and owner root:spyboxd.
# The deploy account must be a member of the spyboxd group for migrations.
DATABASE_URL=postgresql+psycopg://spyboxd:REPLACE_WITH_DATABASE_PASSWORD@127.0.0.1:5432/spyboxd
FRONTEND_URL=https://spyboxd.com
CORS_ALLOWED_ORIGINS=https://spyboxd.com,https://www.spyboxd.com

# Configure one matching production Clerk frontend domain for token verification.
CLERK_JWKS_URL=https://REPLACE_WITH_CLERK_PRODUCTION_DOMAIN/.well-known/jwks.json
# CLERK_FRONTEND_API=https://REPLACE_WITH_CLERK_PRODUCTION_DOMAIN
CLERK_ISSUER=https://REPLACE_WITH_CLERK_PRODUCTION_DOMAIN
CLERK_AUTHORIZED_PARTIES=https://spyboxd.com,https://www.spyboxd.com
# Comma-separated Clerk user IDs that receive admin access independently of
# optional custom session-token metadata claims.
CLERK_ADMIN_USER_IDS=REPLACE_WITH_ADMIN_CLERK_USER_ID

SPYBOXD_MAX_TRACKED_PROFILES_PER_USER=25
SPYBOXD_MAX_PENDING_PROFILE_REQUESTS_PER_USER=10

INGESTION_API_TOKEN=REPLACE_WITH_LONG_RANDOM_UPLOAD_TOKEN

# Optional TMDB enrichment.
# TMDB_API_TOKEN=REPLACE_WITH_TMDB_READ_TOKEN
# TMDB_API_KEY=REPLACE_WITH_TMDB_API_KEY
TMDB_DEFAULT_REGION=DE
TMDB_LANGUAGE=en-US
TMDB_CACHE_DAYS=30
# Pace scheduled API calls while retaining the client's bounded 429/5xx retries.
TMDB_REQUEST_PAUSE_SECONDS=0.25
# The scheduled GitHub workflow processes only stale/missing cache entries and
# never forces refresh. Keep this bounded; at most this many candidate movies
# are handled per run.
TMDB_ENRICHMENT_LIMIT=100
TMDB_ENRICHMENT_BATCH_SIZE=10

UPLOAD_MAX_ARCHIVE_MEMBERS=50000
UPLOAD_MAX_UNCOMPRESSED_BYTES=2147483648
SPYBOXD_RSS_HEALTH_STALE_AFTER_SECONDS=2400
LOG_LEVEL=INFO
