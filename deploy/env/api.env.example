# Install as /etc/spyboxd/api.env with mode 0640 and owner root:spyboxd.
# The deploy account must be a member of the spyboxd group for migrations.
DATABASE_URL=postgresql+psycopg://spyboxd:REPLACE_WITH_DATABASE_PASSWORD@127.0.0.1:5432/spyboxd
FRONTEND_URL=https://spyboxd.com
CORS_ALLOWED_ORIGINS=https://spyboxd.com,https://www.spyboxd.com

# Configure one of these for Clerk token verification.
CLERK_JWKS_URL=https://REPLACE_WITH_CLERK_DOMAIN/.well-known/jwks.json
# CLERK_FRONTEND_API=https://REPLACE_WITH_CLERK_DOMAIN

INGESTION_API_TOKEN=REPLACE_WITH_LONG_RANDOM_UPLOAD_TOKEN

# Optional TMDB enrichment.
# TMDB_API_TOKEN=REPLACE_WITH_TMDB_READ_TOKEN
# TMDB_API_KEY=REPLACE_WITH_TMDB_API_KEY
TMDB_DEFAULT_REGION=DE
TMDB_CACHE_DAYS=30

UPLOAD_MAX_ARCHIVE_MEMBERS=50000
UPLOAD_MAX_UNCOMPRESSED_BYTES=2147483648
SPYBOXD_RSS_HEALTH_STALE_AFTER_SECONDS=28800
LOG_LEVEL=INFO
