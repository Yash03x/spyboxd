# Required only when the restore drill is enabled. Install as
# /etc/spyboxd/restore-drill.env with mode 0640 and owner
# root:spyboxd-deploy so application services cannot read this credential.
# Keep the application role NOCREATEDB. This separate, non-superuser role needs
# CONNECT and read access to production plus CREATEDB solely for isolated drills.
DATABASE_URL=postgresql+psycopg://spyboxd_restore:REPLACE_WITH_DATABASE_PASSWORD@127.0.0.1:5432/spyboxd
