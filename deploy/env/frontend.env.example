# Install as /etc/spyboxd/frontend.env with mode 0640 and owner root:spyboxd.
# The deploy account must be a member of the spyboxd group for builds.
# API_URL is server-only. NEXT_PUBLIC_* values are embedded during the release build.
API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_API_BASE_URL=https://api.spyboxd.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=REPLACE_WITH_CLERK_PUBLISHABLE_KEY
CLERK_SECRET_KEY=REPLACE_WITH_CLERK_SECRET_KEY
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/
