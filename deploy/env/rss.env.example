# Install as /etc/spyboxd/rss.env with mode 0640 and owner root:spyboxd.
# The deploy account must be a member of the spyboxd group for validation.
DATABASE_URL=postgresql+psycopg://spyboxd:REPLACE_WITH_DATABASE_PASSWORD@127.0.0.1:5432/spyboxd
SPYBOXD_RSS_POLL_INTERVAL_SECONDS=7200
SPYBOXD_RSS_SWEEP_SECONDS=300
SPYBOXD_RSS_REQUEST_PAUSE_SECONDS=3
SPYBOXD_RSS_MAX_BACKOFF_SECONDS=86400
SPYBOXD_RSS_BATCH_SIZE=50
SPYBOXD_RSS_USER_AGENT="Spyboxd/1.0 (+https://spyboxd.com)"
LOG_LEVEL=INFO
